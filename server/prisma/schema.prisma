generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  technician
  encoder
}

enum SitioType {
  Sitio
  Purok
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  office       String?
  municipality String?
  role         UserRole @default(encoder)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetTokens PasswordResetToken[]
  activities  Activity[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Barangay {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  area           Float
  classification String
  sitios         Sitio[]
  farmers        Farmer[]
  plantingReports PlantingReport[]
  harvestReports  HarvestReport[]
  standingCrops   StandingCropReport[]
}

model Farmer {
  id              Int       @id @default(autoincrement())
  rsbsaNumber     String    @unique
  lastName        String
  firstName       String
  middleName      String    @default("")
  suffix          String    @default("")
  farmerAddress1  String
  farmerAddress2  String    @default("")
  farmerAddress3  String    @default("")
  farmAddress2    String    @default("")
  farmAddress3    String    @default("")
  birthdate       DateTime? @db.Date
  sex             String
  contactNo       String    @default("")
  fourPs          Boolean   @default(false)
  indigenous      Boolean   @default(false)
  pwd             Boolean   @default(false)
  farmArea        Float     @default(0)
  areaPlanted     Float?
  commodity       String    @default("Rice/Palay")
  farmerGeoCode   String?
  farmGeoCode     String?
  barangayId      Int?
  barangay        Barangay? @relation(fields: [barangayId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lastName, firstName])
  @@index([barangayId])
}

model Sitio {
  id         Int       @id @default(autoincrement())
  barangayId Int
  name       String
  type       SitioType @default(Sitio)
  barangay   Barangay  @relation(fields: [barangayId], references: [id], onDelete: Cascade)

  @@unique([barangayId, name])
}

model PlantingReport {
  id              Int      @id @default(autoincrement())
  municipality    String   @default("Rizal")
  barangayId      Int
  sitio           String   @default("-")
  farmerCount     Int
  seedVariety     String
  areaPlanted     Float
  datePlanted     DateTime @db.Date
  irrigationType  String
  season          String
  expectedHarvest DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  barangay        Barangay @relation(fields: [barangayId], references: [id])
}

model HarvestReport {
  id              Int      @id @default(autoincrement())
  municipality    String   @default("Rizal")
  barangayId      Int
  sitio           String   @default("-")
  harvestDate     DateTime @db.Date
  harvestedArea   Float
  totalProduction Float
  averageYield    Float
  riceVariety     String
  irrigationType  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  barangay        Barangay @relation(fields: [barangayId], references: [id])
}

model StandingCropReport {
  id               Int      @id @default(autoincrement())
  municipality     String   @default("Rizal")
  barangayId       Int
  sitio            String   @default("-")
  cropStage        String
  area             Float
  cropCondition    String
  damagedArea      Float    @default(0)
  pestInfestation  String
  irrigationStatus String
  lastUpdated      DateTime @db.Date
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  barangay         Barangay @relation(fields: [barangayId], references: [id])
}

model Activity {
  id        Int      @id @default(autoincrement())
  action    String
  location  String
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
